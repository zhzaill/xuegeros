{
  "name": "cortico-world-xuegeros",
  "version": "0.3.6",
  "description": "XuegerOS robot World for Coo/Cortico: negotiates bounded intents with the on-board robotd daemon over its 50 Hz WebSocket, persists motion events with cursor replay, and renders action options for the persona.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "files": ["src", "dist", "bin", "runtime", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md"],
  "bin": {"xuegeros": "./bin/xuegeros.mjs"},
  "engines": { "node": ">=22" },
  "keywords": ["cortico-world", "cortico", "coo", "xuegeros", "robotics", "robotd"],
  "scripts": {
    "prepack": "npm run build && node scripts/build-runtime.mjs",
    "build": "node -e \"require('node:fs').copyFileSync('src/webui/client.js', 'dist/webui.js')\"",
    "test": "node --test test/*.test.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "XuegerOS 小车",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "src/webui/style.css",
    "tags": ["robotics", "motion", "robotd"]
  }
}
