<?xml version="1.0"?>
<!--
  xuegeros-car-01 simulation description (Gazebo Classic 11 / ROS 2 Humble).

  Derived from tmp/leap_ros.urdf (the real car's description). The real URDF has
  no inertial/collision data and no Gazebo plugins, so this file adds both while
  keeping every frame name and every measured offset identical to the real car:

    base_footprint -> base_link  z=+0.06205
    wheel centres   x=-0.05075 y=+/-0.081 z=-0.02955  (=> wheel radius 0.0325)
    caster centre   x=+0.06519 z=-0.05115            (=> sphere radius 0.0109)
    laser_frame     x=-0.02270 z=+0.06370
    imu_link        z=+0.03000

  Rates intentionally match the measured real car, NOT the Gazebo defaults:
    /scan ~2.5 Hz, /odom ~13 Hz, /imu ~4 Hz  (see docs/TASK-BLACKBOARD.md req. 5)

  /cmd_vel is the post-watchdog topic. Keeping the default name means the shadow
  base consumes exactly what the real base consumes, so twist_mux -> 200 ms
  watchdog stay inside the loop instead of being bypassed.
-->
<robot name="xuegeros_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="scan_rate" default="2.5"/>
  <xacro:arg name="odom_rate" default="13.0"/>
  <xacro:arg name="imu_rate" default="4.0"/>
  <xacro:arg name="cmd_vel_topic" default="/cmd_vel"/>
  <xacro:arg name="odom_topic" default="/odom"/>
  <xacro:arg name="scan_topic" default="/scan"/>
  <xacro:arg name="imu_topic" default="/imu"/>

  <!-- measured geometry -->
  <xacro:property name="base_z" value="0.06205"/>
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.020"/>
  <xacro:property name="wheel_separation" value="0.162"/>
  <xacro:property name="caster_radius" value="0.0109"/>

  <!--
    The real STLs are already modelled in one assembly frame, and in
    leap_ros.urdf every link's joint origin plus its visual origin cancels out
    to the same offset below. Attaching all visuals to base_link with that one
    offset therefore reproduces the real car exactly, without duplicating the
    eight fixed links. Scales are millimetres in the source files.
  -->
  <xacro:property name="mesh_xyz" value="0.00225 0 -0.00925"/>
  <xacro:property name="mesh_rpy" value="0 0 1.57079632679"/>

  <xacro:macro name="real_mesh" params="file material">
    <visual>
      <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="file://$(find xuegecar_description)/meshes/${file}" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <material name="dark_gray"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="matte_black"><color rgba="0.01 0.01 0.01 1.0"/></material>
  <material name="blue"><color rgba="0.05 0.18 0.8 1.0"/></material>
  <material name="silver"><color rgba="0.65 0.68 0.70 1.0"/></material>

  <!-- ================= links ================= -->

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.010" ixy="0.0" ixz="0.0" iyy="0.020" iyz="0.0" izz="0.020"/>
    </inertial>
    <xacro:real_mesh file="chassis.stl" material="blue"/>
    <xacro:real_mesh file="drive_wheels.stl" material="matte_black"/>
    <xacro:real_mesh file="caster_wheel.stl" material="matte_black"/>
    <xacro:real_mesh file="battery.stl" material="dark_gray"/>
    <xacro:real_mesh file="controller.stl" material="silver"/>
    <xacro:real_mesh file="tt_motor.stl" material="dark_gray"/>
    <xacro:real_mesh file="lidar.stl" material="matte_black"/>
    <xacro:real_mesh file="camera.stl" material="matte_black"/>
    <xacro:real_mesh file="ultrasonic.stl" material="silver"/>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1445 0.095 0.0805"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.7e-5" iyz="0" izz="1.5e-5"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="-0.05075 0.081 -0.02955" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.7e-5" iyz="0" izz="1.5e-5"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-0.05075 -0.081 -0.02955" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="2.0e-6" ixy="0" ixz="0" iyy="2.0e-6" iyz="0" izz="2.0e-6"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.06519 -0.00001 -0.05115" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.0e-5" ixy="0" ixz="0" iyy="1.0e-5" iyz="0" izz="1.0e-5"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.030"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.0227 0.000062 0.0637" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1.0e-7" ixy="0" ixz="0" iyy="1.0e-7" iyz="0" izz="1.0e-7"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ================= Gazebo surface properties ================= -->

  <gazebo reference="base_link">
    <!-- No <material> override: it would repaint all nine STL visuals. The
         URDF colours (blue chassis, silver controller, black lidar) show. -->
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="imu_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ================= differential drive ================= -->
  <!--
    cmd_vel stays on /cmd_vel on purpose: that is the watchdog's output topic, so
    the shadow robot is driven through the same gate as the physical one.
    odometry_source 0 = ENCODER, matching the car (wheel odometry).
  -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=$(arg cmd_vel_topic)</remapping>
        <remapping>odom:=$(arg odom_topic)</remapping>
      </ros>
      <update_rate>$(arg odom_rate)</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>$(arg cmd_vel_topic)</command_topic>
      <odometry_topic>$(arg odom_topic)</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_source>0</odometry_source>
    </plugin>
  </gazebo>

  <!-- ================= lidar ================= -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <always_on>true</always_on>
      <update_rate>$(arg scan_rate)</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=$(arg scan_topic)</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= imu ================= -->
  <!--
    libgazebo_ros_imu_sensor.so is a *SensorPlugin*: its Load() takes a
    gazebo::sensors::Sensor. It therefore has to be declared inside the
    <sensor> element (the same place the ray plugin lives). Declared at link or
    model level it loads as the wrong plugin type and silently publishes nothing.
  -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>$(arg imu_rate)</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=$(arg imu_topic)</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
