<?xml version="1.0"?>
<!--
  room.world - 6 m x 6 m walled room for the xuegeros simulation shadow.

  Everything is defined inline (no model:// includes) so the world does not
  depend on /usr/share/gazebo-11/models being present on the VM.

  The two gazebo_ros system plugins are declared here, so a plain
  `gzserver worlds/room.world` is already a ROS 2 node that publishes /clock
  and offers /spawn_entity.
-->
<sdf version="1.6">
  <world name="xuegeros_room">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!--
      NOTE: libgazebo_ros_init.so and libgazebo_ros_factory.so are Gazebo
      *system* plugins, not WorldPlugins. Declaring them here makes Gazebo log
      "incorrect plugin type" and refuse to load them, so they are passed to
      gzserver with -s from launch/sim.launch.py instead.
    -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 8 0.002</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 8 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- four walls: inner face at +/-3 m -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.05 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.2 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 1.5</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.05 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.2 0.1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 1.5</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.05 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 1.5</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.05 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 1.5</size></box></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- furniture so the scan/map has structure to close loops on -->
    <model name="crate_a">
      <static>true</static>
      <pose>1.2 1.1 0.225 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.45</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_b">
      <static>true</static>
      <pose>-1.4 1.6 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>0.35</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.35</length></cylinder></geometry>
          <material><ambient>0.2 0.45 0.3 1</ambient><diffuse>0.25 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_c">
      <static>true</static>
      <pose>1.9 -1.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.3 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.3 0.6</size></box></geometry>
          <material><ambient>0.35 0.3 0.55 1</ambient><diffuse>0.45 0.4 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
